digraph GompeiVisionStructureDiagram {
    compound=true;
    graph
        [splines=spline
        nodesep=1.0,
        ranksep=1.0
    ];
    node [shape=box];
    rankdir=LR;

    subgraph cluster7 {
        label = "Robot Code (roboRIO / SystemCore)";
        RobotState;
        RobotData;
    }

    subgraph cluster0 {
        label = "GompeiVision Module (one per stereo pair; a robot carries several)";

        subgraph cluster1 {
            label = "Capture";

            StereoCameras;
            IMU;

            StereoFrames;
            IMUSamples;

            StereoCameras -> StereoFrames;
            IMU -> IMUSamples;

            subgraph cluster_framebus {
                label = "FrameBus (Routing Layer)";

                StereoFrameBus;

                StereoFrames -> StereoFrameBus;
            }
        }

        subgraph cluster2 {
            label = "Per-Frame Processing (Pose Measurement Generation)";

            MonoTagPnP;
            StereoTagPnP;

            ObjectRecognition;
            ObjectLocalization;

            StereoFrameBus -> MonoTagPnP [label="each lens"];
            StereoFrameBus -> StereoTagPnP;

            StereoFrameBus -> ObjectRecognition [style="dashed", label="color variant only"];

            ObjectRecognition -> ObjectLocalization;
        }

        subgraph cluster4 {
            label = "Independent Estimation Systems";

            TagSLAM;
            RobotPoseEstimate;
            RefinedTagMap;

            VIO;
            VIOOdometry;

            StereoFrameBus -> TagSLAM;
            StereoFrameBus -> VIO;
            IMUSamples -> VIO;

            RobotData -> TagSLAM;
            RobotData -> VIO [style="dashed", label="heading alignment"];

            TagSLAM -> RobotPoseEstimate;
            TagSLAM -> RefinedTagMap;

            VIO -> VIOOdometry;
        }

        subgraph cluster5 {
            label = "Vision Output (CAN-FD fast path + NetworkTables)";

            PoseMeasurements;
            ObjectData;
            MapData;

            MonoTagPnP -> PoseMeasurements;
            StereoTagPnP -> PoseMeasurements;

            ObjectLocalization -> ObjectData;

            RobotPoseEstimate -> PoseMeasurements;
            VIOOdometry -> PoseMeasurements;

            RefinedTagMap -> MapData;
        }

        subgraph cluster6 {
            label = "Persistent Storage (Module)";

            MapStorage;
            VideoRecording;

            RefinedTagMap -> MapStorage [
                label="save refined tag map"
            ];

            MapStorage -> TagSLAM [
                label="load at boot",
                style="dashed"
            ];

            StereoFrameBus -> VideoRecording [
                label="VCU encode to M.2 SSD"
            ];
        }
    }


    PoseMeasurements -> RobotState [
        style="dotted",
        label="tag poses, VIO deltas + velocity"
    ];

    ObjectData -> RobotState [
        style="dotted",
        label="object poses"
    ];

    MapData -> RobotState [
        style="dotted",
        label="refined apriltag map"
    ];

    RobotState -> RobotData [
        label="Heading\nModulePositions\nAprilTagMap\nRecordingControl"
    ];
}
