digraph GompeiVisionStructureDiagram {
    compound=true;
    graph
        [splines=spline
        nodesep=1.0,
        ranksep=1.0
    ];
    node [shape=box];
    rankdir=LR;

    subgraph cluster0 {
        label = "GompeiVision Module (one lens; a robot carries several)";

        subgraph cluster1 {
            label = "Capture";

            Camera;
            Frames;

            Camera -> Frames;

            subgraph cluster_framebus {
                label = "FrameBus (Routing Layer)";

                FrameBus;

                Frames -> FrameBus;
            }
        }

        subgraph cluster2 {
            label = "Per-Frame Processing";

            TagDetection;
            CornerOutput;
            ModuleTagPnP;

            ObjectRecognition;
            ObjectLocalization;

            FrameBus -> TagDetection;
            TagDetection -> CornerOutput [label="undistort"];
            TagDetection -> ModuleTagPnP;

            FrameBus -> ObjectRecognition [label="downscaled"];
            ObjectRecognition -> ObjectLocalization;
        }

        subgraph cluster5 {
            label = "Vision Output";

            TagCorners [label="TagCorners (CAN-FD)"];
            ModulePoses [label="ModulePoses (NetworkTables)"];
            ObjectData [label="ObjectData (NetworkTables)"];

            CornerOutput -> TagCorners;
            ModuleTagPnP -> ModulePoses;
            ObjectLocalization -> ObjectData;
        }

        subgraph cluster6 {
            label = "Persistent Storage (Module)";

            TagMapStorage;
            VideoRecording;

            FrameBus -> VideoRecording [
                label="VCU encode to M.2 SSD"
            ];
        }
    }

    subgraph cluster7 {
        label = "Robot Code (SystemCore)";

        RobotPnP [label="RobotPnP (all modules, gyro at capture time)"];
        PoseEstimator;
        RobotState;
        RobotData;

        RobotPnP -> PoseEstimator [label="addVisionMeasurement"];
        PoseEstimator -> RobotState;
        RobotState -> RobotData;
        RobotData -> RobotPnP [label="gyro history, tag map,\nmodule positions", style="dashed"];
    }

    subgraph cluster8 {
        label = "Offline (Desktop)";

        TagSLAM;
        RefinedTagMap;

        TagSLAM -> RefinedTagMap;
    }

    TagCorners -> RobotPnP [
        style="dotted",
        label="corners every frame"
    ];

    ModulePoses -> RobotState [
        style="dotted",
        label="display / NT-only robots"
    ];

    ObjectData -> RobotState [
        style="dotted",
        label="object poses"
    ];

    RobotData -> TagSLAM [
        style="dashed",
        label="logged corners + odometry (WPILOG)"
    ];

    VideoRecording -> TagSLAM [
        style="dashed",
        label="recording metadata"
    ];

    RefinedTagMap -> RobotData [
        label="field layout"
    ];

    RobotData -> TagMapStorage [
        label="config, calibration,\ntag map, recording control"
    ];

    TagMapStorage -> ModuleTagPnP [
        label="load at boot",
        style="dashed"
    ];
}
