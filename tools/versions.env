# Pinned toolchain versions for GompeiVision (FPGA version).
#
# Sourced by scripts/bootstrap.sh and scripts/doctor.sh, so this is the one
# place a version changes. Plain KEY=value lines only (no spaces around "=",
# no command substitution), so other tools can read this file too.
#
# Open-source tools: bootstrap.sh installs exactly these versions. doctor.sh
# accepts these versions or newer. *_MIN marks a floor, not a pin.
# AMD tools: can't be redistributed, so doctor.sh only checks they match.

# --- Hardware track (RTL, simulation) ---------------------------------------
# cocotb 2.x needs Verilator >= 5.036; Ubuntu 24.04 apt ships 5.020
VERILATOR_VERSION=5.048
VERIBLE_VERSION=v0.0-4023-gc1271a00
COCOTB_VERSION=2.1.0
PYTEST_VERSION=9.0.3
PYTHON_MIN=3.10

# --- AMD tools (provisional until Stage 0b) ---------------------------------
# Vitis AI 3.5 and its DPUCZDX8G 4.1 IP (the K26 DPU) are verified only with
# the 2023.1 tools, and newer Vitis AI releases target Versal. Stage 0b
# confirms or changes this.
# Vivado, Vitis, PetaLinux
AMD_TOOLS_VERSION=2023.1
VITIS_AI_VERSION=3.5
DPU_IP=DPUCZDX8G-4.1

# --- RPU track (Cortex-R5F bare metal / FreeRTOS) ---------------------------
ARM_NONE_EABI_GCC_MIN=13.2

# --- APU track (Cortex-A53 Linux apps) and the legacy CPU pipeline ----------
AARCH64_GCC_MIN=13.2
# matches cmake_minimum_required in CMakeLists.txt
CMAKE_MIN=3.30
# Ubuntu 24.04's apt CMake is 3.28, so bootstrap.sh installs this one from
# PyPI into the repo's .venv (the same version the legacy Dockerfiles use).
CMAKE_VERSION=3.31.10
NINJA_MIN=1.11
# WPILib C++ libraries for the module's ntcore/wpimath (and the legacy
# pipeline). Keep in sync with versions.json.
WPILIB_MODULE_VERSION=2025.1.1

# --- Robot track (SystemCore robot library) ---------------------------------
# WPILib 2027 / SystemCore
JDK_VERSION=25
WPILIB_ROBOT_VERSION=2027.0.0-alpha-6

# --- ML track (object detection) --------------------------------------------
DOCKER_MIN=24.0
VITIS_AI_DOCKER_IMAGE=xilinx/vitis-ai-pytorch-cpu:ubuntu2004-3.5.0.306
